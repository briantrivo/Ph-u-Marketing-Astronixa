# ==========================================
# CẤU HÌNH HỆ THỐNG PHỄU OHANA-C AUTOMATION
# ==========================================

# 1. Telegram Bot Token (Lấy từ @BotFather trên Telegram)
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE

# 2. Telegram Admin ID (Lấy từ @userinfobot, nhiều ID cách nhau bằng dấu phẩy)
ADMIN_TELEGRAM_IDS=123456789,987654321

# 3. Cổng chạy Server Webhook & API nội bộ
PORT=3002

# 4. Webhook Google Sheet CRM (Tùy chọn: URL Google Apps Script Web App để lưu Lead)
GOOGLE_SHEET_WEBHOOK_URL=

# 5. Link Video Onboarding 5 Bước (Thay bằng link Youtube / Drive / Telegram file của bạn)
VIDEO_STEP_1_URL=https://www.youtube.com/watch?v=example1
VIDEO_STEP_2_URL=https://www.youtube.com/watch?v=example2
VIDEO_STEP_3_URL=https://www.youtube.com/watch?v=example3
VIDEO_STEP_4_URL=https://www.youtube.com/watch?v=example4
VIDEO_STEP_5_URL=https://www.youtube.com/watch?v=example5

# 6. Các đường dẫn cộng đồng & sự kiện
OHANA_REGISTER_URL=https://ohana.astronixa.com/register
OHANA_TELEGRAM_COMMUNITY=https://t.me/astronixa_community
OHANA_ZALO_COMMUNITY=https://zalo.me/g/example
OHANA_HOTLINE=0931332671
WEBINAR_ZOOM_LINK=https://zoom.us/j/example
